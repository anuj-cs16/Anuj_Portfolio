{
  "name": "anuj-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Full-Stack MERN Personal Portfolio for Anuj Dubey - Single Folder Deployment",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "build": "npx vite build",
    "server": "npx nodemon server.js",
    "client": "npx vite",
    "dev": "npx concurrently \"npm run server\" \"npm run client\"",
    "seed": "node -e \"require('./utils/seeder').seedData(true)\""
  },
  "dependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "framer-motion": "^11.2.10",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.395.0",
    "mongoose": "^8.4.1",
    "nodemailer": "^6.9.13",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.2.1",
    "react-router-dom": "^6.23.1",
    "react-simple-typewriter": "^5.0.1",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.12"
